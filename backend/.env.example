# Server
PORT=4000

# Environment: "development" (default) or "production". Affects error verbosity,
# dev-only routes (e.g. GET /api/dev/db-check), and cookie/security hardening.
# NODE_ENV=development

# Database (REQUIRED): PostgreSQL/Neon connection string used by the running app.
# Use the POOLED connection (pgbouncer) here, e.g. ...-pooler.<region>.neon.tech/...?pgbouncer=true&sslmode=require
# App refuses to start if unset.
DATABASE_URL=postgresql://user:password@host-pooler/dbname?pgbouncer=true&sslmode=require

# Direct (UNPOOLED) connection used by `prisma migrate` / `prisma db push`.
# In dev you can point it at the same value as DATABASE_URL; in prod use the
# unpooled Neon URL so migrations don't run through pgbouncer.
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Structured logging (pino). Level: trace|debug|info|warn|error (default info).
# Silent automatically under NODE_ENV=test.
# LOG_LEVEL=info
# Warn on any DB query slower than this many ms (development only).
# SLOW_QUERY_MS=200

# Frontend URL (for CORS). This origin is added to the CORS allowlist alongside
# the localhost dev origins. Auth uses Bearer tokens, so cookies/credentials are NOT sent.
FRONTEND_URL=http://localhost:3000

# Trust proxy for X-Forwarded-For handling (affects rate limiting / req.ip).
# Leave unset for local dev (loopback only). Behind N reverse proxies, set the
# number of trusted hops, e.g. TRUST_PROXY=1. Trusting arbitrary XFF lets clients
# spoof their IP and bypass rate limits, so keep this as small as possible.
# TRUST_PROXY=1

# Auth (REQUIRED): secret to sign/verify JWTs. Must be >= 32 chars. App refuses to start if unset/too short.
JWT_SECRET=your-secret-at-least-32-chars-long

# Optional: backend base URL (e.g. for email verification links)
# BACKEND_URL=http://localhost:4000

# Razorpay (for real payments). Get test keys from dashboard.razorpay.com → Settings → API Keys (Test mode).
# If unset, payment page falls back to demo (no real charge).
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_key_secret

# Email. Provider is selected by EMAIL_PROVIDER (default "smtp"); if the selected
# provider is unconfigured, emails are skipped gracefully (no error) and an
# EmailLog row is written with status SKIPPED.
#   smtp     -> uses SMTP_HOST/PORT/USER/PASS below (nodemailer)
#   resend   -> uses RESEND_API_KEY (HTTP)
#   postmark -> uses POSTMARK_TOKEN (HTTP)
# EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# RESEND_API_KEY=re_xxx
# POSTMARK_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# From address for ALL providers. Align its domain with SPF/DKIM for deliverability.
MAIL_FROM=noreply@yourdomain.com
APP_NAME=tiqr
# Non-blocking send retries on transient failure (exponential backoff). Default 3.
# EMAIL_MAX_RETRIES=3

# CAPTCHA (signup/signin bot protection). Graceful degradation like Razorpay/email:
# if CAPTCHA_SECRET is unset the integration is DISABLED and every token verifies
# as true (any placeholder token passes), so auth keeps working with no provider
# wired up. When set, tokens are verified server-side and the check fails CLOSED
# on any network/parse error. Pair with the frontend's NEXT_PUBLIC_CAPTCHA_SITE_KEY.
# CAPTCHA_SECRET=your-turnstile-secret
# Provider siteverify endpoint. Defaults to Cloudflare Turnstile if unset.
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
