# Server
PORT=4000

# Environment: "development" (default) or "production". Affects error verbosity,
# dev-only routes (e.g. GET /api/dev/db-check), and cookie/security hardening.
# NODE_ENV=development

# Database (REQUIRED): PostgreSQL/Neon connection string used by the running app.
# Use the POOLED connection (pgbouncer) here, e.g. ...-pooler.<region>.neon.tech/...?pgbouncer=true&sslmode=require
# App refuses to start if unset.
DATABASE_URL=postgresql://user:password@host-pooler/dbname?pgbouncer=true&sslmode=require

# Direct (UNPOOLED) connection used by `prisma migrate` / `prisma db push`.
# In dev you can point it at the same value as DATABASE_URL; in prod use the
# unpooled Neon URL so migrations don't run through pgbouncer.
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Error tracking (OPS-02, Sentry). OPTIONAL and gated: when SENTRY_DSN is unset,
# Sentry is never initialised — no network calls, boot is byte-for-byte unchanged.
# Only server faults (unhandled 500s + uncaught/unhandled process errors) are
# reported, tagged with request_id + user id, with PII/secrets scrubbed.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Metrics (OPS-03, Prometheus). GET /api/metrics exposes process + HTTP-duration +
# business counters. Open in development; in PRODUCTION it requires a bearer token
# and FAILS CLOSED when METRICS_TOKEN is unset (so the route inventory + figures
# aren't world-readable). Scrape with: Authorization: Bearer <METRICS_TOKEN>.
# METRICS_TOKEN=a-long-random-scrape-token

# Structured logging (pino). Level: trace|debug|info|warn|error (default info).
# Silent automatically under NODE_ENV=test.
# LOG_LEVEL=info
# Warn on any DB query slower than this many ms (development only).
# SLOW_QUERY_MS=200

# Frontend URL (for CORS). This origin is added to the CORS allowlist alongside
# the localhost dev origins. Auth uses Bearer tokens, so cookies/credentials are NOT sent.
FRONTEND_URL=http://localhost:3000

# Public base URL of THIS API, used to build absolute links in emails (e.g. the
# PAY-07 invoice download link). Defaults to http://localhost:$PORT when unset.
PUBLIC_API_URL=http://localhost:4000

# Trust proxy for X-Forwarded-For handling (affects rate limiting / req.ip).
# Leave unset for local dev (loopback only). Behind N reverse proxies, set the
# number of trusted hops, e.g. TRUST_PROXY=1. Trusting arbitrary XFF lets clients
# spoof their IP and bypass rate limits, so keep this as small as possible.
# TRUST_PROXY=1

# Auth (REQUIRED): secret to sign/verify JWTs. Must be >= 32 chars. App refuses to start if unset/too short.
JWT_SECRET=your-secret-at-least-32-chars-long

# Optional: backend base URL (e.g. for email verification links)
# BACKEND_URL=http://localhost:4000

# Razorpay (for real payments). Get test keys from dashboard.razorpay.com → Settings → API Keys (Test mode).
# If unset, payment page falls back to demo (no real charge).
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_key_secret
# Webhook signing secret (PAY-01). Set the SAME value in the Razorpay dashboard
# webhook config; POST /api/bookings/webhook/razorpay is HMAC-verified with it so
# a captured payment settles the booking server-side even if the browser never
# calls verify-payment. If unset, the webhook route 503s (like the other RZP endpoints).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email. Provider is selected by EMAIL_PROVIDER (default "smtp"); if the selected
# provider is unconfigured, emails are skipped gracefully (no error) and an
# EmailLog row is written with status SKIPPED.
#   smtp     -> uses SMTP_HOST/PORT/USER/PASS below (nodemailer)
#   resend   -> uses RESEND_API_KEY (HTTP)
#   postmark -> uses POSTMARK_TOKEN (HTTP)
# EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# RESEND_API_KEY=re_xxx
# POSTMARK_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# From address for ALL providers. Align its domain with SPF/DKIM for deliverability.
MAIL_FROM=noreply@yourdomain.com
APP_NAME=tiqr
# Non-blocking send retries on transient failure (exponential backoff). Default 3.
# EMAIL_MAX_RETRIES=3

# CAPTCHA (signup/signin bot protection). Graceful degradation like Razorpay/email:
# if CAPTCHA_SECRET is unset the integration is DISABLED and every token verifies
# as true (any placeholder token passes), so auth keeps working with no provider
# wired up. When set, tokens are verified server-side and the check fails CLOSED
# on any network/parse error. Pair with the frontend's NEXT_PUBLIC_CAPTCHA_SITE_KEY.
# CAPTCHA_SECRET=your-turnstile-secret
# Provider siteverify endpoint. Defaults to Cloudflare Turnstile if unset.
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Two-factor auth (AUTH-08). Encrypts TOTP secrets at rest. Optional — falls back
# to JWT_SECRET when unset, but set a dedicated 32+ char key in production so
# rotating JWT_SECRET doesn't invalidate everyone's 2FA secret.
# TWO_FACTOR_ENC_KEY=change-me-to-a-long-random-string

# Google sign-in (AUTH-05). OPTIONAL: when GOOGLE_CLIENT_ID is unset the buttons
# stay disabled and POST /api/auth/google returns 503 (dev/E2E unaffected). The
# same OAuth client id is exposed to the frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# SMS / WhatsApp ticket delivery (NOTIF-07). OPTIONAL and gated like email: when
# SMS_PROVIDER is unset (or the selected provider's keys are missing) sends are
# skipped and completion is unaffected. Provider: msg91 | gupshup | twilio.
# Numbers are normalized to E.164 with SMS_DEFAULT_COUNTRY (default +91). India
# DLT: msg91/gupshup need a registered sender ID + template for production.
# SMS_PROVIDER=twilio
# SMS_DEFAULT_COUNTRY=+91
# Twilio:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_SMS_FROM=+10000000000
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# MSG91:
# MSG91_AUTHKEY=your-msg91-authkey
# MSG91_SENDER_ID=TIQRAP
# Gupshup:
# GUPSHUP_USER_ID=your-gupshup-userid
# GUPSHUP_PASSWORD=your-gupshup-password

# Wallet passes (TIX-07). OPTIONAL and gated like Razorpay/email: if the creds
# for a wallet are unset, its endpoint returns 503 WALLET_DISABLED and the UI
# hides the button. NEVER commit real certs/keys — supply them via secrets.
#
# Apple Wallet — needs an Apple Developer Pass Type ID + the WWDR cert. The three
# certs/keys are PEM, supplied base64-encoded (or raw PEM) so they survive an env
# var. Generate base64 with e.g. `base64 -w0 signerCert.pem`.
# APPLE_WALLET_PASS_TYPE_ID=pass.com.yourorg.tiqr
# APPLE_WALLET_TEAM_ID=ABCDE12345
# APPLE_WALLET_SIGNER_CERT=<base64 of the pass-type signing certificate (PEM)>
# APPLE_WALLET_SIGNER_KEY=<base64 of the signing private key (PEM)>
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=your-key-passphrase   # omit if the key is unencrypted
# APPLE_WALLET_WWDR_CERT=<base64 of Apple's WWDR intermediate certificate (PEM)>
# APPLE_WALLET_ORG_NAME=tiqr
#
# Google Wallet — a Wallet API issuer account + a service-account key. The save
# link is an RS256 JWT signed with the service-account private key (PEM; literal
# \n sequences are accepted).
# GOOGLE_WALLET_ISSUER_ID=3388000000022222228
# GOOGLE_WALLET_SA_EMAIL=wallet@your-project.iam.gserviceaccount.com
# GOOGLE_WALLET_SA_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WALLET_CLASS_SUFFIX=tiqr_event   # optional; the eventTicketClass suffix
