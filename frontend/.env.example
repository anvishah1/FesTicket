# Frontend (Next.js) public env. Copy to .env.local and adjust as needed.
# NOTE: NEXT_PUBLIC_* vars are inlined into the client bundle at build time —
# never put secrets here.

# Base URL of the backend API. All backend calls go through getApiUrl()
# (see frontend/lib/auth.ts). Defaults to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:4000

# CAPTCHA (Cloudflare Turnstile) site key for the signup/signin widgets.
# Graceful degradation: when UNSET the real Turnstile widget is not rendered
# (the demo "I'm not a robot" checkbox is used) and a placeholder token is sent,
# which the backend accepts when its CAPTCHA_SECRET is also unset. Set both this
# and the backend CAPTCHA_SECRET to enable real captcha verification.
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=your-turnstile-site-key
