generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==================== USER & AUTH ====================

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String?
  name              String?
  phone             String?
  organizationName  String?
  organizationEmail String?
  role              Role      @default(VIEWER)
  roleStatus        RoleStatus @default(ACTIVE)
  profileCompleted  Boolean   @default(false)
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  lastLogin         DateTime?
  failedLoginAttempts Int     @default(0)
  lockUntil         DateTime?
  managedFestId     Int?      @unique // for ADMIN: which fest they manage (key belongs to that fest)
  editorFestId      Int?      // for EDITOR: which fest they were approved for (from RoleRequest)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  hostedEvents      Event[]
  bookings         Booking[]
  expenses         Expense[]
  roleRequests     RoleRequest[] @relation("requester")
  reviewedRequests RoleRequest[] @relation("reviewer")
  refreshTokens    RefreshToken[]
  managedFest      Fest?      @relation("festAdmin", fields: [managedFestId], references: [id])
  editorFest       Fest?      @relation("festEditors", fields: [editorFestId], references: [id])
}

enum Role {
  VIEWER
  EDITOR
  HOST
  ADMIN
}

enum RoleStatus {
  ACTIVE
  PENDING
  DENIED
}

// ==================== FEST & EVENTS ====================

model Fest {
  id          Int       @id @default(autoincrement())
  name        String
  college     String
  description String?
  image       String?
  startDate   DateTime?
  endDate     DateTime?
  adminKey    String?   @unique  // key given to admin; students enter this to request editor for this fest
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  events         Event[]
  sponsors       Sponsor[]
  expenses       Expense[]
  roleRequests   RoleRequest[]
  admin          User?           @relation("festAdmin")
  editors        User[]          @relation("festEditors")
  adminRequests  AdminRequest[]
}

model Event {
  id               Int         @id @default(autoincrement())
  festId           Int?
  hostId           Int?
  name             String
  shortDescription String?
  description      String?
  aboutEvent       String?
  image            String?
  category         String?
  startDate        DateTime?
  endDate          DateTime?
  startTime        String?
  endTime          String?
  venue            String?
  venueAddress     String?
  onlineLink       String?
  isOnline         Boolean     @default(false)
  visibility       Visibility  @default(PUBLIC)
  status           EventStatus @default(PUBLISHED)
  discount         Float       @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  fest          Fest?        @relation(fields: [festId], references: [id])
  host          User?        @relation(fields: [hostId], references: [id])
  ticketTypes   TicketType[]
  bookings      Booking[]
  sponsors      Sponsor[]
  expenses      Expense[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UPCOMING
  LIVE
  PAST
  CANCELLED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ==================== TICKETS ====================

model TicketType {
  id          Int       @id @default(autoincrement())
  eventId     Int
  name        String
  price       Float
  quantity    Int
  sold        Int       @default(0)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
  attendees    Attendee[]
}

// ==================== BOOKINGS ====================

model Booking {
  id           Int           @id @default(autoincrement())
  bookingCode  String        @unique @default(cuid())
  eventId      Int
  userId       Int?
  guestEmail   String?
  guestName    String?
  guestPhone   String?
  subtotal     Float
  platformFee  Float         @default(0)
  tax          Float         @default(0)
  total        Float
  status       BookingStatus @default(PENDING)
  purchaseDate DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  event        Event         @relation(fields: [eventId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  items        BookingItem[]
  attendees    Attendee[]
  payment      Payment?
}

model BookingItem {
  id           Int       @id @default(autoincrement())
  bookingId    Int
  ticketTypeId Int
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  createdAt    DateTime  @default(now())

  // Relations
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
}

model Attendee {
  id           Int       @id @default(autoincrement())
  bookingId    Int
  ticketTypeId Int
  name         String
  email        String
  createdAt    DateTime  @default(now())

  // Relations
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// ==================== PAYMENTS ====================

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  orderId       String?
  amount        Float
  method        PaymentMethod?
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==================== SPONSORS ====================

model Sponsor {
  id                Int           @id @default(autoincrement())
  festId            Int?
  eventId           Int?
  companyName       String
  contactPerson     String
  email             String?
  phone             String?
  sponsorshipAmount Float
  receivedAmount    Float         @default(0)
  status            SponsorStatus @default(NEGOTIATING)
  notes             String?
  agreementUrl      String?
  agreementType     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  fest  Fest?  @relation(fields: [festId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])
}

enum SponsorStatus {
  NEGOTIATING
  PENDING
  CONFIRMED
}

// ==================== EXPENSES ====================

model Expense {
  id            Int             @id @default(autoincrement())
  hostId        Int
  festId        Int?
  eventId       Int?
  description   String
  category      ExpenseCategory
  vendor        String
  amount        Float
  paymentDate   DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  host   User          @relation(fields: [hostId], references: [id])
  fest   Fest?         @relation(fields: [festId], references: [id])
  event  Event?        @relation(fields: [eventId], references: [id])
  files  ExpenseFile[]
}

model ExpenseFile {
  id        Int       @id @default(autoincrement())
  expenseId Int
  fileName  String
  fileType  FileType
  fileUrl   String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime  @default(now())

  // Relations
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

enum ExpenseCategory {
  INFRASTRUCTURE
  MARKETING
  ARTIST_FEES
  CATERING
  TRANSPORTATION
  SECURITY
  DECORATION
  SOUND_AV
  PRIZES
  MISCELLANEOUS
}

enum FileType {
  PROOF
  BILL
}

// ==================== AUTH: ROLE REQUESTS & REFRESH TOKENS ====================

model RoleRequest {
  id             Int              @id @default(autoincrement())
  userId         Int
  festId         Int?             // fest this request is for (from fest key)
  requestedRole  Role
  organization   String?
  status         RoleRequestStatus @default(PENDING)
  requestDate    DateTime         @default(now())
  reviewedAt     DateTime?
  reviewedById   Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation("requester", fields: [userId], references: [id])
  reviewedBy     User?            @relation("reviewer", fields: [reviewedById], references: [id])
  fest           Fest?            @relation(fields: [festId], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ==================== ADMIN REQUESTS (professor requests access; dev approves and sets credentials) ====================

model AdminRequest {
  id            Int                 @id @default(autoincrement())
  email         String
  name          String?
  organization  String?             // college / institution (used as fest college when creating fest)
  festName      String?             // name of the fest they want to create (used when approving with "new")
  phone         String?
  status        AdminRequestStatus  @default(PENDING)
  // Set when approved (so you can see credentials and fest conclusively)
  passwordSet   String?             // plaintext password set for this admin
  adminKeySet   String?             // fest key set for students/editors
  festId        Int?                // fest they were approved to manage
  fest          Fest?               @relation(fields: [festId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum AdminRequestStatus {
  PENDING
  APPROVED
  DENIED
}
