generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer) for the running app.
  url       = env("DATABASE_URL")
  // Unpooled/direct connection used by prisma migrate/db push. Optional in dev
  // (falls back to DATABASE_URL when unset); set it in prod for migrations.
  directUrl = env("DIRECT_URL")
}

// ==================== USER & AUTH ====================

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String?
  name              String?
  phone             String?
  organizationName  String?
  organizationEmail String?
  role              Role      @default(VIEWER)
  roleStatus        RoleStatus @default(ACTIVE)
  profileCompleted  Boolean   @default(false)
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  lastLogin         DateTime?
  failedLoginAttempts Int     @default(0)
  lockUntil         DateTime?
  tokenVersion      Int       @default(0) // bumped on password/role change to invalidate live access tokens
  // AUTH-04: soft-delete. Non-null => the account is deleted (PII scrubbed). Every
  // authenticated request and signin treats a deletedAt user as nonexistent. Soft
  // (not hard) delete because User has non-cascading FKs (bookings, events, ...).
  deletedAt         DateTime?
  managedFestId     Int?      @unique // for ADMIN: which fest they manage (key belongs to that fest)
  editorFestId      Int?      // for EDITOR: which fest they were approved for (from RoleRequest)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  hostedEvents      Event[]
  bookings         Booking[]
  expenses         Expense[]
  roleRequests     RoleRequest[] @relation("requester")
  reviewedRequests RoleRequest[] @relation("reviewer")
  refreshTokens    RefreshToken[]
  managedFest      Fest?      @relation("festAdmin", fields: [managedFestId], references: [id])
  editorFest       Fest?      @relation("festEditors", fields: [editorFestId], references: [id])
}

enum Role {
  VIEWER
  EDITOR
  HOST
  ADMIN
}

enum RoleStatus {
  ACTIVE
  PENDING
  DENIED
}

// ==================== FEST & EVENTS ====================

model Fest {
  id          Int       @id @default(autoincrement())
  name        String
  college     String
  description String?
  image       String?
  startDate   DateTime?
  endDate     DateTime?
  adminKey    String?   @unique  // key given to admin; students enter this to request editor for this fest
  isDeleted   Boolean   @default(false) // soft-delete flag; DELETE /api/fests/:id archives instead of removing
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  events         Event[]
  sponsors       Sponsor[]
  expenses       Expense[]
  roleRequests   RoleRequest[]
  admin          User?           @relation("festAdmin")
  editors        User[]          @relation("festEditors")
  adminRequests  AdminRequest[]
}

model Event {
  id               Int         @id @default(autoincrement())
  festId           Int?
  hostId           Int?
  name             String
  shortDescription String?
  description      String?
  aboutEvent       String?
  audience         String?
  image            String?
  category         String?
  startDate        DateTime?
  endDate          DateTime?
  startTime        String?
  endTime          String?
  venue            String?
  venueAddress     String?
  onlineLink       String?
  isOnline         Boolean     @default(false)
  visibility       Visibility  @default(PUBLIC)
  status           EventStatus @default(PUBLISHED)
  discount         Float       @default(0)
  // PAY-06: buyer refund policy. refundCutoffHours applies only to
  // FULL_UNTIL_CUTOFF (a refund is allowed up to startDate - refundCutoffHours).
  refundPolicy      RefundPolicy @default(NO_REFUND)
  refundCutoffHours Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  fest          Fest?        @relation(fields: [festId], references: [id])
  host          User?        @relation(fields: [hostId], references: [id])
  ticketTypes   TicketType[]
  bookings      Booking[]
  sponsors      Sponsor[]
  expenses      Expense[]
  questions     EventQuestion[]

  @@index([festId])
  @@index([hostId])
  @@index([status])
  @@index([visibility])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UPCOMING
  LIVE
  PAST
  CANCELLED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// PAY-06: how buyers may self-service refund a completed booking.
enum RefundPolicy {
  NO_REFUND
  FULL_ANYTIME
  FULL_UNTIL_CUTOFF
}

// ==================== TICKETS ====================

model TicketType {
  id          Int       @id @default(autoincrement())
  eventId     Int
  name        String
  price       Int // paise (PAY-03)
  quantity    Int
  sold        Int       @default(0)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
  attendees    Attendee[]

  @@index([eventId])
}

// ==================== BOOKINGS ====================

model Booking {
  id           Int           @id @default(autoincrement())
  bookingCode  String        @unique @default(cuid())
  // PAY-07: stable GST-invoice number, assigned once when the booking completes
  // (format TIQR-<year>-<id>). Null until completion; unique across all bookings.
  invoiceNumber String?      @unique
  eventId      Int
  userId       Int?
  guestEmail   String?
  guestName    String?
  guestPhone   String?
  subtotal     Int // paise (PAY-03)
  discount     Int           @default(0) // paise
  platformFee  Int           @default(0) // paise
  tax          Int           @default(0) // paise
  total        Int // paise
  status       BookingStatus @default(PENDING)
  promoCodeId  Int?          // applied promo code (PAY-04)
  promoDiscount Int          @default(0) // paise discounted by the promo code
  refundedAmount Int         @default(0) // paise refunded so far (PAY-02)
  refundReason String?
  purchaseDate DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  event        Event         @relation(fields: [eventId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  items        BookingItem[]
  attendees    Attendee[]
  payment      Payment?
  answers      AttendeeAnswer[]

  // Composite indexes back the hottest queries: eventId+status (host event
  // bookings / buyers), status+createdAt (stale-pending sweep), guestEmail
  // (guest lookup), eventId+purchaseDate (fest/buyer lists ordered by date).
  // [eventId,status] and [eventId,purchaseDate] both prefix-cover eventId, so the
  // standalone @@index([eventId]) is dropped as redundant.
  @@index([eventId, status])
  @@index([eventId, purchaseDate])
  @@index([status, createdAt])
  @@index([guestEmail])
  @@index([userId])
}

model BookingItem {
  id           Int       @id @default(autoincrement())
  bookingId    Int
  ticketTypeId Int
  quantity     Int
  unitPrice    Int // paise (PAY-03)
  totalPrice   Int // paise (PAY-03)
  createdAt    DateTime  @default(now())

  // Relations
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([bookingId])
}

model Attendee {
  id           Int       @id @default(autoincrement())
  bookingId    Int
  ticketTypeId Int
  name         String
  email        String
  // TIX-02: per-attendee scannable ticket code (cuid, unguessable + unique).
  ticketCode   String    @unique @default(cuid())
  // TIX-03: door check-in. checkedInAt set on first scan (atomic, first-wins);
  // checkedInById is the admitting host/admin (bare Int?, no formal FK).
  checkedInAt   DateTime?
  checkedInById Int?
  createdAt    DateTime  @default(now())

  // Relations
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([bookingId])
  @@index([ticketTypeId])
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// ==================== PAYMENTS ====================

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  orderId       String?
  amount        Int // paise (PAY-03)
  refundedAmount Int          @default(0) // paise refunded so far (PAY-02)
  refundId      String?
  method        PaymentMethod?
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==================== SPONSORS ====================

model Sponsor {
  id                Int           @id @default(autoincrement())
  festId            Int?
  eventId           Int?
  companyName       String
  contactPerson     String
  email             String?
  phone             String?
  sponsorshipAmount Int // paise (PAY-03)
  receivedAmount    Int           @default(0) // paise
  status            SponsorStatus @default(NEGOTIATING)
  notes             String?
  agreementUrl      String?
  agreementType     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  fest  Fest?  @relation(fields: [festId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([festId])
  @@index([eventId])
}

enum SponsorStatus {
  NEGOTIATING
  PENDING
  CONFIRMED
}

// ==================== EXPENSES ====================

model Expense {
  id            Int             @id @default(autoincrement())
  hostId        Int
  festId        Int?
  eventId       Int?
  description   String
  category      ExpenseCategory
  vendor        String
  amount        Int // paise (PAY-03)
  paymentDate   DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  host   User          @relation(fields: [hostId], references: [id])
  fest   Fest?         @relation(fields: [festId], references: [id])
  event  Event?        @relation(fields: [eventId], references: [id])
  files  ExpenseFile[]

  @@index([hostId])
  @@index([festId])
  @@index([eventId])
}

model ExpenseFile {
  id        Int       @id @default(autoincrement())
  expenseId Int
  fileName  String
  fileType  FileType
  fileUrl   String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime  @default(now())

  // Relations
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

enum ExpenseCategory {
  INFRASTRUCTURE
  MARKETING
  ARTIST_FEES
  CATERING
  TRANSPORTATION
  SECURITY
  DECORATION
  SOUND_AV
  PRIZES
  MISCELLANEOUS
}

enum FileType {
  PROOF
  BILL
}

// ==================== AUTH: ROLE REQUESTS & REFRESH TOKENS ====================

model RoleRequest {
  id             Int              @id @default(autoincrement())
  userId         Int
  festId         Int?             // fest this request is for (from fest key)
  requestedRole  Role
  organization   String?
  status         RoleRequestStatus @default(PENDING)
  requestDate    DateTime         @default(now())
  reviewedAt     DateTime?
  reviewedById   Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation("requester", fields: [userId], references: [id])
  reviewedBy     User?            @relation("reviewer", fields: [reviewedById], references: [id])
  fest           Fest?            @relation(fields: [festId], references: [id])

  @@index([userId])
  @@index([festId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  familyId  String?  // lineage id shared across a rotation chain; used for reuse/replay detection
  revokedAt DateTime? // set when rotated (kept as a tombstone so a replay of the old token can be detected)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ==================== ADMIN REQUESTS (professor requests access; dev approves and sets credentials) ====================

model AdminRequest {
  id            Int                 @id @default(autoincrement())
  email         String
  name          String?
  organization  String?             // college / institution (used as fest college when creating fest)
  festName      String?             // name of the fest they want to create (used when approving with "new")
  phone         String?
  status        AdminRequestStatus  @default(PENDING)
  // Set when approved (so you can see credentials and fest conclusively)
  passwordSet   String?             // plaintext password set for this admin
  adminKeySet   String?             // fest key set for students/editors
  festId        Int?                // fest they were approved to manage
  fest          Fest?               @relation(fields: [festId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum AdminRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ==================== EVENT QUESTIONS & ATTENDEE ANSWERS ====================

model EventQuestion {
  id        Int      @id @default(autoincrement())
  eventId   Int
  label     String
  type      String   @default("text")
  options   String?
  required  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model AttendeeAnswer {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  questionId Int
  value      String
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ==================== EMAIL DELIVERY LOG ====================
// One row per send attempt (NOTIF-04). Lets us see delivery status, dedupe, and
// drive retry/backoff without changing sendMail's caller contract.
model EmailLog {
  id                Int         @id @default(autoincrement())
  toEmail           String
  subject           String
  template          String?
  bookingId         Int?
  provider          String?
  providerMessageId String?
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  lastError         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([bookingId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// ==================== WEBHOOK IDEMPOTENCY ====================
// One row per received provider webhook (PAY-01). Razorpay retries a webhook for
// up to 24h, so we dedupe on the provider's event id and only process once.
model WebhookEvent {
  id          Int       @id @default(autoincrement())
  provider    String    @default("razorpay")
  eventId     String    @unique
  type        String
  payload     String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ==================== PROMO CODES (PAY-04) ====================
// A reusable discount code scoped to a fest or a single event. Money is paise.
model PromoCode {
  id               Int       @id @default(autoincrement())
  code             String
  festId           Int?
  eventId          Int?
  kind             PromoKind
  percentOff       Int? // 0..100, for PERCENT
  flatOffPaise     Int? // paise, for FLAT
  maxDiscountPaise Int? // cap on a PERCENT discount
  minSubtotalPaise Int? // minimum (pre-discount) subtotal to qualify
  maxRedemptions   Int? // null = unlimited
  redeemedCount    Int       @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([festId, code])
  @@index([eventId])
}

enum PromoKind {
  PERCENT
  FLAT
}