generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==================== USER & AUTH ====================

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String?
  name              String?
  phone             String?
  organizationName  String?
  role              Role      @default(VIEWER)
  profileCompleted  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  hostedEvents      Event[]
  bookings          Booking[]
  expenses          Expense[]
}

enum Role {
  VIEWER
  HOST
  ADMIN
}

// ==================== FEST & EVENTS ====================

model Fest {
  id          Int       @id @default(autoincrement())
  name        String
  college     String
  description String?
  image       String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  events      Event[]
  sponsors    Sponsor[]
  expenses    Expense[]
}

model Event {
  id               Int         @id @default(autoincrement())
  festId           Int?
  hostId           Int?
  name             String
  shortDescription String?
  description      String?
  aboutEvent       String?
  image            String?
  category         String?
  startDate        DateTime?
  endDate          DateTime?
  startTime        String?
  endTime          String?
  venue            String?
  venueAddress     String?
  onlineLink       String?
  isOnline         Boolean     @default(false)
  visibility       Visibility  @default(PUBLIC)
  status           EventStatus @default(DRAFT)
  discount         Float       @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  fest          Fest?        @relation(fields: [festId], references: [id])
  host          User?        @relation(fields: [hostId], references: [id])
  ticketTypes   TicketType[]
  bookings      Booking[]
  sponsors      Sponsor[]
  expenses      Expense[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UPCOMING
  LIVE
  PAST
  CANCELLED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ==================== TICKETS ====================

model TicketType {
  id          Int       @id @default(autoincrement())
  eventId     Int
  name        String
  price       Float
  quantity    Int
  sold        Int       @default(0)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
  attendees    Attendee[]
}

// ==================== BOOKINGS ====================

model Booking {
  id           Int           @id @default(autoincrement())
  bookingCode  String        @unique @default(cuid())
  eventId      Int
  userId       Int?
  guestEmail   String?
  guestName    String?
  guestPhone   String?
  subtotal     Float
  platformFee  Float         @default(0)
  tax          Float         @default(0)
  total        Float
  status       BookingStatus @default(PENDING)
  purchaseDate DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  event        Event         @relation(fields: [eventId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  items        BookingItem[]
  attendees    Attendee[]
  payment      Payment?
}

model BookingItem {
  id           Int       @id @default(autoincrement())
  bookingId    Int
  ticketTypeId Int
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  createdAt    DateTime  @default(now())

  // Relations
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
}

model Attendee {
  id           Int       @id @default(autoincrement())
  bookingId    Int
  ticketTypeId Int
  name         String
  email        String
  createdAt    DateTime  @default(now())

  // Relations
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// ==================== PAYMENTS ====================

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  orderId       String?
  amount        Float
  method        PaymentMethod?
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==================== SPONSORS ====================

model Sponsor {
  id                Int           @id @default(autoincrement())
  festId            Int?
  eventId           Int?
  companyName       String
  contactPerson     String
  email             String?
  phone             String?
  sponsorshipAmount Float
  receivedAmount    Float         @default(0)
  status            SponsorStatus @default(NEGOTIATING)
  notes             String?
  agreementUrl      String?
  agreementType     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  fest  Fest?  @relation(fields: [festId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])
}

enum SponsorStatus {
  NEGOTIATING
  PENDING
  CONFIRMED
}

// ==================== EXPENSES ====================

model Expense {
  id            Int             @id @default(autoincrement())
  hostId        Int
  festId        Int?
  eventId       Int?
  description   String
  category      ExpenseCategory
  vendor        String
  amount        Float
  paymentDate   DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  host   User          @relation(fields: [hostId], references: [id])
  fest   Fest?         @relation(fields: [festId], references: [id])
  event  Event?        @relation(fields: [eventId], references: [id])
  files  ExpenseFile[]
}

model ExpenseFile {
  id        Int       @id @default(autoincrement())
  expenseId Int
  fileName  String
  fileType  FileType
  fileUrl   String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime  @default(now())

  // Relations
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

enum ExpenseCategory {
  INFRASTRUCTURE
  MARKETING
  ARTIST_FEES
  CATERING
  TRANSPORTATION
  SECURITY
  DECORATION
  SOUND_AV
  PRIZES
  MISCELLANEOUS
}

enum FileType {
  PROOF
  BILL
}
